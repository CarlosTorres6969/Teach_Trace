# Obligatorio: genere un valor aleatorio propio de al menos 32 caracteres.
JWT_SECRET=reemplace-con-un-secreto-aleatorio-de-64-caracteres
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DEMO_SEED=false
DATABASE_PATH=teachtrace.sqlite
DATABASE_AUTOSAVE=true
DATABASE_SYNCHRONIZE=true
DOCUMENT_REPOSITORY_PATH=backend/document-repository
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# Recuperación de contraseña por Gmail SMTP
PUBLIC_APP_URL=http://localhost:5173
PASSWORD_RESET_TTL_MS=1800000
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ─── Web Push (notificaciones push al navegador) ──────────────────────────────
# Generar claves VAPID con el siguiente comando (una sola vez):
#   node -e "const wp = require('web-push'); const k = wp.generateVAPIDKeys(); console.log('PUBLIC=' + k.publicKey); console.log('PRIVATE=' + k.privateKey);"
# O instalar web-push globalmente: npm install -g web-push && web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@unah.edu.hn
