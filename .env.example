# Obligatorio: genere un valor aleatorio propio de al menos 32 caracteres.
JWT_SECRET=reemplace-con-un-secreto-aleatorio-de-64-caracteres
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SAMESITE=strict
# En producción HTTPS debe ser true; en desarrollo HTTP puede omitirse.
SESSION_COOKIE_SECURE=false
DEMO_SEED=false
DATABASE_PATH=teachtrace.sqlite
DATABASE_AUTOSAVE=true
DATABASE_SYNCHRONIZE=true
# Para Supabase PostgreSQL, defina DATABASE_URL y use DATABASE_SYNCHRONIZE=false.
# En Vercel/serverless use el Transaction pooler (puerto 6543):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# DATABASE_SSL=true
DB_POOL_MAX=2
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=10000
# Azure Blob Storage es el repositorio recomendado para despliegue. Si se deja
# vacío, el backend usa DOCUMENT_REPOSITORY_PATH como fallback local.
DOCUMENT_STORAGE_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=teachtrace-submissions
DOCUMENT_REPOSITORY_PATH=backend/document-repository
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# Recuperación de contraseña por Gmail SMTP
PUBLIC_APP_URL=http://localhost:5173
PASSWORD_RESET_TTL_MS=1800000
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ─── Web Push (notificaciones push al navegador) ──────────────────────────────
# Generar claves VAPID con el siguiente comando (una sola vez):
#   node -e "const wp = require('web-push'); const k = wp.generateVAPIDKeys(); console.log('PUBLIC=' + k.publicKey); console.log('PRIVATE=' + k.privateKey);"
# O instalar web-push globalmente: npm install -g web-push && web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@unah.edu.hn

# Motor IA: Google Gemini mediante API compatible con OpenAI Chat Completions.
# La clave permanece vacía para no publicar secretos y exigir revisión manual.
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARS=100000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=500
# Cabeceras opcionales para proveedores como OpenRouter:
# AI_HTTP_REFERER=http://localhost:5173
# AI_X_TITLE=TeachTrace
